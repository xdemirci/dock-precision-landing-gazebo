<?xml version="1.0"?>
<!-- uretildi: gen_dock.py h=7 ped_w=1.8 mark_h=0.35 -->
<sdf version="1.9">
  <model name="dock_model_4">

    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl"/>

    <!-- GOVDE: ayak (link z -7..0) + taban 2x2 + ArUco. Link orijini taban alt yuzu (dunya z=7) -->
    <link name="body">
      <pose>0 0 7 0 0 0</pose>
      <inertial>
        <pose>0 0 -3.15 0 0 0</pose>
        <mass>560</mass>
        <inertia><ixx>2437.87</ixx><iyy>2437.87</iyy><izz>302.4</izz></inertia>
      </inertial>

      <collision name="pedestal_c">
        <pose>0 0 -3.5 0 0 0</pose>
        <geometry><box><size>1.8 1.8 7</size></box></geometry>
      </collision>
      <visual name="pedestal_v">
        <pose>0 0 -3.5 0 0 0</pose>
        <geometry><box><size>1.8 1.8 7</size></box></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>

      <collision name="bottom_c">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry><box><size>2 2 0.05</size></box></geometry>
      </collision>
      <visual name="bottom_v">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry><box><size>2 2 0.05</size></box></geometry>
        <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>

      
      <collision name="markpad_c">
        <pose>0 0 0.225 0 0 0</pose>
        <geometry><box><size>0.8 0.8 0.35</size></box></geometry>
      </collision>
      <visual name="markpad_v">
        <pose>0 0 0.225 0 0 0</pose>
        <geometry><box><size>0.8 0.8 0.35</size></box></geometry>
        <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
      </visual>

      <visual name="aruco_plate_v">
        <pose>0 0 0.4005 0 0 0</pose>
        <geometry><box><size>0.8 0.8 0.001</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>

      <visual name="aruco_v">
        <pose>0 0 0.402 0 0 0</pose>
        <geometry>
          <plane><normal>0 0 1</normal><size>0.5 0.5</size></plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://arucotag1/arucotag1.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <link name="left_side">
      <pose>-1 0 7.05 0 0 0</pose>
      <inertial>
        <pose>0.2 0 0.45 0 0 0</pose>
        <mass>5</mass>
        <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
      </inertial>
      <collision name="left_side_wall_c">
        <pose>0.025 0 0.45 0 0 0</pose>
        <geometry><box><size>0.05 2 0.9</size></box></geometry>
      </collision>
      <visual name="left_side_wall_v">
        <pose>0.025 0 0.45 0 0 0</pose>
        <geometry><box><size>0.05 2 0.9</size></box></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
      <collision name="left_side_flap_c">
        <pose>0.5 0 0.925 0 0 0</pose>
        <geometry><box><size>1 2 0.05</size></box></geometry>
      </collision>
      <visual name="left_side_flap_v">
        <pose>0.5 0 0.925 0 0 0</pose>
        <geometry><box><size>1 2 0.05</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
      </visual>
    </link>

    <joint name="left_joint" type="revolute">
      <parent>body</parent>
      <child>left_side</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.6</lower><upper>0</upper></limit>
        <dynamics><damping>5</damping></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>left_joint</joint_name>
      <topic>/dock_4/left/cmd</topic>
      <p_gain>300</p_gain><i_gain>2</i_gain><d_gain>30</d_gain>
    </plugin>

    <link name="right_side">
      <pose>1 0 7.05 0 0 0</pose>
      <inertial>
        <pose>-0.2 0 0.45 0 0 0</pose>
        <mass>5</mass>
        <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
      </inertial>
      <collision name="right_side_wall_c">
        <pose>-0.025 0 0.45 0 0 0</pose>
        <geometry><box><size>0.05 2 0.9</size></box></geometry>
      </collision>
      <visual name="right_side_wall_v">
        <pose>-0.025 0 0.45 0 0 0</pose>
        <geometry><box><size>0.05 2 0.9</size></box></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
      <collision name="right_side_flap_c">
        <pose>-0.5 0 0.925 0 0 0</pose>
        <geometry><box><size>1 2 0.05</size></box></geometry>
      </collision>
      <visual name="right_side_flap_v">
        <pose>-0.5 0 0.925 0 0 0</pose>
        <geometry><box><size>1 2 0.05</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
      </visual>
    </link>

    <joint name="right_joint" type="revolute">
      <parent>body</parent>
      <child>right_side</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>0</lower><upper>1.6</upper></limit>
        <dynamics><damping>5</damping></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>right_joint</joint_name>
      <topic>/dock_4/right/cmd</topic>
      <p_gain>300</p_gain><i_gain>2</i_gain><d_gain>30</d_gain>
    </plugin>

    <!-- front_panel: tek parca panel, alt kenardan mentese (y=1.0) -->
    <link name="front_panel">
      <pose>0 1.0 7.05 0 0 0</pose>
      <inertial>
        <pose>0 -0.025 0.45 0 0 0</pose>
        <mass>4</mass>
        <inertia><ixx>0.27</ixx><iyy>1.44</iyy><izz>1.18</izz></inertia>
      </inertial>
      <collision name="front_panel_c">
        <pose>0 -0.025 0.45 0 0 0</pose>
        <geometry><box><size>1.88 0.05 0.89</size></box></geometry>
      </collision>
      <visual name="front_panel_v">
        <pose>0 -0.025 0.45 0 0 0</pose>
        <geometry><box><size>1.88 0.05 0.89</size></box></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
    </link>

    <joint name="front_panel_joint" type="revolute">
      <parent>body</parent>
      <child>front_panel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1.6</lower><upper>0</upper></limit>
        <dynamics><damping>5</damping></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>front_panel_joint</joint_name>
      <topic>/dock_4/left/cmd</topic>
      <p_gain>300</p_gain><i_gain>2</i_gain><d_gain>30</d_gain>
    </plugin>

    <!-- back_panel: tek parca panel, alt kenardan mentese (y=-1.0) -->
    <link name="back_panel">
      <pose>0 -1.0 7.05 0 0 0</pose>
      <inertial>
        <pose>0 0.025 0.45 0 0 0</pose>
        <mass>4</mass>
        <inertia><ixx>0.27</ixx><iyy>1.44</iyy><izz>1.18</izz></inertia>
      </inertial>
      <collision name="back_panel_c">
        <pose>0 0.025 0.45 0 0 0</pose>
        <geometry><box><size>1.88 0.05 0.89</size></box></geometry>
      </collision>
      <visual name="back_panel_v">
        <pose>0 0.025 0.45 0 0 0</pose>
        <geometry><box><size>1.88 0.05 0.89</size></box></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
    </link>

    <joint name="back_panel_joint" type="revolute">
      <parent>body</parent>
      <child>back_panel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>0</lower><upper>1.6</upper></limit>
        <dynamics><damping>5</damping></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>back_panel_joint</joint_name>
      <topic>/dock_4/right/cmd</topic>
      <p_gain>300</p_gain><i_gain>2</i_gain><d_gain>30</d_gain>
    </plugin>

  </model>
</sdf>
