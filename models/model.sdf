<?xml version="1.0"?>
<sdf version="1.9">
  <model name="dock_model">

    <!-- SİYAH: sabit taban 2x2, z 0..0.05 + ArUco -->
    <link name="body">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.025 0 0 0</pose>
        <mass>50</mass>
        <inertia><ixx>16.7</ixx><iyy>16.7</iyy><izz>33.3</izz></inertia>
      </inertial>
      <collision name="bottom_c">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry><box><size>2 2 0.05</size></box></geometry>
      </collision>
      <visual name="bottom_v">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry><box><size>2 2 0.05</size></box></geometry>
        <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
      
      
      <!-- beyaz plaka: z 0.050..0.051, sadece visual -->
			<visual name="aruco_plate_v">
				<pose>0 0 0.0505 0 0 0</pose>
				<geometry><box><size>0.8 0.8 0.001</size></box></geometry>
				<material>
					<ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
					<specular>0 0 0 1</specular>
				</material>
			</visual>

      <!-- ARUCO: tabanın üst yüzü z=0.05, z-fighting olmasın diye +1 mm -->
      <visual name="aruco_v">
        <pose>0 0 0.052 0 0 0</pose>
        <geometry>
          <plane><normal>0 0 1</normal><size>0.5 0.5</size></plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://arucotag1/arucotag1.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <!-- YEŞİL + TURUNCU (sol): orijin = menteşe (x=-1, z=0.05) -->
    <link name="left_side">
      <pose>-1 0 0.05 0 0 0</pose>
      <inertial>
        <pose>0.2 0 0.45 0 0 0</pose>
        <mass>5</mass>
        <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
      </inertial>
      <collision name="left_c">
        <pose>0.025 0 0.45 0 0 0</pose>
        <geometry><box><size>0.05 2 0.9</size></box></geometry>
      </collision>
      <visual name="left_v">
        <pose>0.025 0 0.45 0 0 0</pose>
        <geometry><box><size>0.05 2 0.9</size></box></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>
      <collision name="left_top_c">
        <pose>0.5 0 0.925 0 0 0</pose>
        <geometry><box><size>1 2 0.05</size></box></geometry>
      </collision>
      <visual name="left_top_v">
        <pose>0.5 0 0.925 0 0 0</pose>
        <geometry><box><size>1 2 0.05</size></box></geometry>
        <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
      </visual>
    </link>

    <!-- MAVİ + KIRMIZI (sağ): orijin = menteşe (x=1, z=0.05) -->
    <link name="right_side">
      <pose>1 0 0.05 0 0 0</pose>
      <inertial>
        <pose>-0.2 0 0.45 0 0 0</pose>
        <mass>5</mass>
        <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
      </inertial>
      <collision name="right_c">
        <pose>-0.025 0 0.45 0 0 0</pose>
        <geometry><box><size>0.05 2 0.9</size></box></geometry>
      </collision>
      <visual name="right_v">
        <pose>-0.025 0 0.45 0 0 0</pose>
        <geometry><box><size>0.05 2 0.9</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
      </visual>
      <collision name="top_c">
        <pose>-0.5 0 0.925 0 0 0</pose>
        <geometry><box><size>1 2 0.05</size></box></geometry>
      </collision>
      <visual name="top_v">
        <pose>-0.5 0 0.925 0 0 0</pose>
        <geometry><box><size>1 2 0.05</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
    </link>

    <joint name="left_joint" type="revolute">
      <parent>body</parent>
      <child>left_side</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.6</lower><upper>0</upper></limit>
        <dynamics><damping>5</damping></dynamics>
      </axis>
    </joint>

    <joint name="right_joint" type="revolute">
      <parent>body</parent>
      <child>right_side</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>0</lower><upper>1.6</upper></limit>
        <dynamics><damping>5</damping></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>left_joint</joint_name>
      <topic>/dock/left/cmd</topic>
      <p_gain>300</p_gain><i_gain>2</i_gain><d_gain>30</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>right_joint</joint_name>
      <topic>/dock/right/cmd</topic>
      <p_gain>300</p_gain><i_gain>2</i_gain><d_gain>30</d_gain>
    </plugin>
  </model>
</sdf>
